fun is_prime(x, primes) {
    var y = 0;
    var run = true
    while(run) {
        var p = primes[y]
        var pp = p*p
        if(pp > x) {
            run = false
        } else {
            if(x % p == 0) {
                return false
            }
        }
        y = y + 1
    }
    return true
}

var primes = [ 2 ]
var i = 3;
while(i < 100000) {
    if(is_prime(i, primes)) {
        append(primes, i)
    }
    i = i + 2
}
print(primes)
