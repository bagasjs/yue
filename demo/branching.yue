print ("What would you like to buy?")
print ("1.  Small Kitchen")
print ("2.  Large Kitchen")
print ("3.  Pharmacy")
print ("4.  Refrigerator")
print ("5.  Shelves")
print ("6.  Record Player")
print ("7.  Appliances")
print ("8.  Knife set")
print ("9.  Frying Pan")
print ("10. Pot")
print ("11. Oven")
print ("12. Mixer")
print ("13. Steamer")

var choice = 2;
print ("Choice :", choice)

if(choice == 1) {
    print ("This one really is a bargain")
} else if(choice == 2) {
    print ("This will really expand your repertoire")
} else if(choice == 3) {
    print ("You can make all kinds of remedies with this")
} else if(choice == 4) {
    print ("You can keep raw foods fresh")
} else if(choice == 5) {
    print ("Things just seem to pile up, don't they? These will really come in handy")
} else if(choice == 6) {
    print ("I have no idea how it works, but somehow there's music in there.")
} else if(choice == 7) {
    print ("Buy six different appliances all together as a special promotion! This is a real bargain!")
} else if(choice == 8) {
    print ("A kitchen knife is one of the basics for cooking.")
} else if(choice == 9) {
    print ("You can't cook without a frying pan")
} else if(choice == 10) {
    print ("You know you're a full-fledged chef if you own a good pot.")
} else if(choice == 11) {
    print ("It takes some getting used to, but some foods just can't be made without an oven")
} else if(choice == 12) {
    print ("Mixers are nice to have... You've got to have one of these")
} else if(choice == 13) {
    print ("If you can cook using a steamer then your cooking is nearly pro!")
} else {
    print ("See you again!")
}
